---
interface Props {
  variant?: "cta" | "compact";
}

const { variant = "compact" } = Astro.props;
---

{
  variant === "cta" ? (
<footer style="max-width: 960px; margin: 64px auto 0; padding: 40px 32px 48px; box-sizing: border-box; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px 48px">
<div style="display: flex; flex-direction: column; gap: 8px; min-width: 0">
<h2 style="margin: 0; font-size: clamp(1.7rem, 3vw, 2.25rem); line-height: 1.15; font-weight: 600; letter-spacing: -0.03em">Building something with agents?</h2>
<a href="mailto:h@tihado.com" style="font-size: 20px; padding: 10px 0; overflow-wrap: anywhere">h@tihado.com</a>
</div>
<div style="display: flex; flex-direction: column; gap: 4px; font-size: 15px; color: var(--muted)">
<div style="display: flex; flex-wrap: wrap; gap: 4px 24px">
<a href="https://github.com/honghanhh" style="color: var(--muted); padding: 10px 0">GitHub</a>
<a href="https://scholar.google.com/citations?user=OGb4sloAAAAJ" style="color: var(--muted); padding: 10px 0">Google Scholar</a>
<a href="https://www.linkedin.com/in/hanh-thi-hong-tran-0b886212a/" style="color: var(--muted); padding: 10px 0">LinkedIn</a>
<a href="https://tihado.com" style="color: var(--muted); padding: 10px 0">Tihado</a>
</div>
<div>© 2026 Tran Thi Hong Hanh · Paris, France</div>
</div>
</footer>
  ) : (
<footer style="max-width: 960px; margin: 56px auto 0; padding: 28px 32px 40px; box-sizing: border-box; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 32px; font-size: 15px; color: var(--muted)">
<a href="mailto:h@tihado.com" style="font-size: 17px; font-weight: 500; padding: 10px 0">h@tihado.com</a>
<div style="display: flex; flex-wrap: wrap; gap: 4px 24px">
<a href="https://github.com/honghanhh" style="color: var(--muted); padding: 10px 0">GitHub</a>
<a href="https://scholar.google.com/citations?user=OGb4sloAAAAJ" style="color: var(--muted); padding: 10px 0">Google Scholar</a>
<a href="https://www.linkedin.com/in/hanh-thi-hong-tran-0b886212a/" style="color: var(--muted); padding: 10px 0">LinkedIn</a>
<a href="https://tihado.com" style="color: var(--muted); padding: 10px 0">Tihado</a>
</div>
</footer>
  )
}
