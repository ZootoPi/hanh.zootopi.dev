---
import GoogleScholar from "./icons/GoogleScholar.astro";
import Github from "./icons/Github.astro";
import LinkedIn from "./icons/LinkedIn.astro";
import Mail from "./icons/Mail.astro";
---

<footer class="w-full border-border border-t bg-background">
  <div class="container mx-auto px-4 py-8 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
      <p class="text-muted-foreground text-sm">2026 © Thi Hong Hanh Tran</p>
      <div class="flex items-center gap-4">
        <a
          aria-label="Google Scholar"
          class="cursor-pointer rounded-sm text-muted-foreground transition-colors duration-200 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
          href="https://scholar.google.com/citations?user=OGb4sloAAAAJ&hl=fr"
          rel="noopener noreferrer"
          target="_blank"
        >
          <GoogleScholar size={24} />
        </a>
        <a
          aria-label="Github"
          class="cursor-pointer rounded-sm text-muted-foreground transition-colors duration-200 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
          href="https://github.com/honghanhh"
          rel="noopener noreferrer"
          target="_blank"
        >
          <Github size={24} />
        </a>
        <a
          aria-label="LinkedIn"
          class="cursor-pointer rounded-sm text-muted-foreground transition-colors duration-200 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
          href="https://www.linkedin.com/in/hanh-thi-hong-tran-0b886212a/"
          rel="noopener noreferrer"
          target="_blank"
        >
          <LinkedIn size={24} />
        </a>
        <a
          aria-label="Mail"
          class="cursor-pointer rounded-sm text-muted-foreground transition-colors duration-200 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
          href="mailto:hanh@zootopi.dev"
        >
          <Mail size={24} />
        </a>
      </div>
    </div>
  </div>
</footer>
